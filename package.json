{
  "name": "loreline-minds",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "npm run build && node --experimental-strip-types --test tests/core.test.mjs && npm run test:contracts",
    "test:contracts": "hardhat test solidity",
    "contracts:bytecode": "hardhat compile && node scripts/export-receipt-bytecode.mjs",
    "lint": "eslint .",
    "minds:check": "minds doctor --pretty",
    "minds:poc": "node scripts/minds-poc.mjs"
  },
  "dependencies": {
    "@animocabrands/minds-client-lib": "^0.1.3",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "viem": "^2.55.16"
  },
  "devDependencies": {
    "@animocabrands/minds-cli": "^0.1.3",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "hardhat": "^3.13.0",
    "solc": "^0.8.31",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "type": "module",
  "displayName": "Loreline"
}
